# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Base URL of the application under test
BASE_URL=https://notion-knockoff-mvp.vercel.app

# Environment label (selects an optional .env.<ENV> file)
ENV=local

# Vercel Deployment Protection bypass — only needed for preview deployments.
# When empty, no bypass headers are sent.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Test account (username/password form on the login screen)
TEST_USER_USERNAME=
TEST_USER_PASSWORD=

# Prefix for every page/record the tests create, so cleanup can find leftovers
DATA_TEST_PREFIX=qa-auto-
